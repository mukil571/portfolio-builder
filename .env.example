# ============================================
# Loriyum - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://user:password@localhost:5432/loriyum

# ---- Authentication (Better Auth) ----
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# ---- AI Providers (add whichever you use) ----
# OpenAI
OPENAI_API_KEY=

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Default AI provider: "openai" | "gemini" | "anthropic"
AI_PROVIDER=gemini

# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Loriyum
