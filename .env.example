# ============================================
# Loriyum - Environment Variables Template
# ============================================
# Copy this file to .env.local for local development.
# For production (Vercel), configure these in your Project Settings > Environment Variables.

# ---- Database (Hosted PostgreSQL / Neon) ----
# For production (e.g., Neon), use the pooled connection string (with ?sslmode=require)
# for the application runtime to prevent connection exhaustion.
# Example: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/loriyum

# ---- Authentication (Better Auth) ----
# Generate a secure 32+ character key: `openssl rand -base64 32`
BETTER_AUTH_SECRET=generate-a-secure-random-32-byte-secret-here
# Production URL (e.g. https://your-app.vercel.app or https://yourdomain.com)
BETTER_AUTH_URL=http://localhost:3000

# ---- AI Providers (Set the key for your active AI_PROVIDER) ----
# Active AI provider: "gemini" | "openai" | "anthropic"
AI_PROVIDER=gemini

# Google Gemini API key (recommended default)
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI API key (if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic API key (if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# ---- Application Public Configuration ----
# Must match your public production domain (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Loriyum
